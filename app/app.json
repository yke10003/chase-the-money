{
  "expo": {
    "name": "Nolume",
    "slug": "sidehustle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sidehustle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "nl.10003.nolume",
      "appleTeamId": "MS9WS4X64S",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow the camera so you can photograph what you're selling.",
        "NSPhotoLibraryUsageDescription": "Allow photos so you can add pictures of what you're selling."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "redirects": [
            { "source": "/sell/new", "destination": "/create/sell/new" },
            { "source": "/sell/listed", "destination": "/create/sell/listed" },
            { "source": "/sell/setup/[id]", "destination": "/create/sell/setup/[id]" },
            { "source": "/sell/items/[id]", "destination": "/product/[id]" },
            { "source": "/sell/items/[id]/edit", "destination": "/product/[id]" },
            { "source": "/sell/items/[id]/collage", "destination": "/product/[id]" }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F7",
          "image": "./assets/branding/splash-lockup-light.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/branding/splash-lockup-dark.png",
            "backgroundColor": "#131315"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow photos so you can add pictures of what you're selling.",
          "cameraPermission": "Allow the camera so you can photograph what you're selling."
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
